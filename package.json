{
  "name": "testtrace",
  "version": "0.1.0",
  "private": true,
  "description": "TestTrace Intelligence — monorepo (nguồn: plan kiến trúc repository + Q2)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "env:check": "node scripts/env-check.mjs",
    "db:create": "node scripts/db.mjs create",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:migrate:test": "node scripts/db.mjs migrate:test",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:restore": "node scripts/db-backup.mjs restore",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "dev": "echo \"Chua co app rung duoc: PLAT-01 chi dung khung (xem docs/spec/slice-1-tickets.md)\" && exit 1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^6",
    "@testtrace/domain": "workspace:*",
    "eslint": "^9.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.3",
    "prisma": "^6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.20.5"
    }
  }
}
