// Prisma schema — DB-01: User, Project, ProjectMember (nguồn: plan M01 + DB-01).
// Quy ước: ID UUID;ProjectMember duy nhất theo (projectId, userId); thời gian UTC do PG quản.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  TESTER
  VIEWER
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  name         String?
  createdAt    DateTime        @default(now())
  members      ProjectMember[]
  sessions     RefreshToken[]
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   ProjectMember[]
  requirements Requirement[]
  suites TestSuite[]
  testCases TestCase[]
  releases Release[]
  environments Environment[]
}

model ProjectMember {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @db.Uuid
  actorId    String
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())

  // Bất biến: không có code update/delete event ở bất kỳ đâu (nguồn: plan M08).

  @@index([projectId])
  @@index([entityType, entityId])
}

enum RequirementStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

model Requirement {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  code        String
  title       String
  description String?
  status      RequirementStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteria AcceptanceCriterion[]
  risk     Risk?
  revisions RequirementRevision[]
  reviewTasks ReviewTask[]
  testLinks RequirementTestCase[]

  @@unique([projectId, code])
  @@index([projectId, status])
}

model AcceptanceCriterion {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  text          String
  position      Int
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model Risk {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @unique @db.Uuid
  impact        Int
  likelihood    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model RequirementRevision {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  version       Int
  title         String
  description   String?
  createdBy     String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, version])
  @@index([requirementId])
}

model ReviewTask {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  requirementId String   @db.Uuid
  testCaseId    String?  @db.Uuid
  reason        String
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

enum TestCaseStatus {
  DRAFT
  READY
  RETIRED
}

model TestSuite {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   TestSuite?  @relation("SuiteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSuite[] @relation("SuiteTree")
  cases    TestCase[]

  @@index([projectId])
  @@index([parentId])
}

model TestCase {
  id                String         @id @default(uuid()) @db.Uuid
  projectId         String         @db.Uuid
  suiteId           String?        @db.Uuid
  code              String
  title             String
  priority          String         @default("MEDIUM")
  type              String         @default("FUNCTIONAL")
  status            TestCaseStatus @default(DRAFT)
  expectedResult    String?
  independentReason String?
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite     TestSuite?            @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  steps     TestStep[]
  revisions TestCaseRevision[]
  links     RequirementTestCase[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([suiteId])
}

model TestStep {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @db.Uuid
  position   Int
  action     String
  expected   String?
  createdAt  DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
}

model TestCaseRevision {
  id             String   @id @default(uuid()) @db.Uuid
  testCaseId     String   @db.Uuid
  version        Int
  title          String
  priority       String
  type           String
  expectedResult String?
  steps          Json
  createdBy      String
  createdAt      DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, version])
  @@index([testCaseId])
}

model RequirementTestCase {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  testCaseId    String   @db.Uuid
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
}

enum ReleaseStatus {
  DRAFT
  IN_TEST
  PASSED
  FAILED
  RELEASED
  ARCHIVED
}

model Release {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  name      String
  status    ReleaseStatus @default(DRAFT)
  frozen    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builds  Build[]

  @@index([projectId])
}

model Build {
  id        String   @id @default(uuid()) @db.Uuid
  releaseId String   @db.Uuid
  number    String
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, number])
  @@index([releaseId])
}

model Environment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}
