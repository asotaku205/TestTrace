// Prisma schema — DB-01: User, Project, ProjectMember (nguồn: plan M01 + DB-01).
// Quy ước: ID UUID;ProjectMember duy nhất theo (projectId, userId); thời gian UTC do PG quản.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  TESTER
  VIEWER
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  name         String?
  createdAt    DateTime        @default(now())
  members      ProjectMember[]
  sessions     RefreshToken[]
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   ProjectMember[]
}

model ProjectMember {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @db.Uuid
  actorId    String
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())

  // Bất biến: không có code update/delete event ở bất kỳ đâu (nguồn: plan M08).

  @@index([projectId])
  @@index([entityType, entityId])
}
