// Prisma schema — DB-01: User, Project, ProjectMember (nguồn: plan M01 + DB-01).
// Quy ước: ID UUID;ProjectMember duy nhất theo (projectId, userId); thời gian UTC do PG quản.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MANAGER
  TESTER
  VIEWER
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  name         String?
  createdAt    DateTime        @default(now())
  members      ProjectMember[]
  sessions     RefreshToken[]
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  members   ProjectMember[]
  requirements Requirement[]
  suites TestSuite[]
  testCases TestCase[]
  releases Release[]
  environments Environment[]
  runs TestRun[]
  defects Defect[]
  evidence Evidence[]
  analyses Analysis[]
  designModels DesignModel[]
  drafts TestDraft[]
  artifacts CodeArtifact[]
  impacts ImpactAnalysis[]
  gates QualityGate[]
  evaluations GateEvaluation[]
}

model ProjectMember {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @db.Uuid
  actorId    String
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())

  // Bất biến: không có code update/delete event ở bất kỳ đâu (nguồn: plan M08).

  @@index([projectId])
  @@index([entityType, entityId])
}

enum RequirementStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

model Requirement {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  code        String
  title       String
  description String?
  status      RequirementStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteria AcceptanceCriterion[]
  risk     Risk?
  revisions RequirementRevision[]
  reviewTasks ReviewTask[]
  testLinks RequirementTestCase[]
  codeLinks RequirementCodeUnit[]

  @@unique([projectId, code])
  @@index([projectId, status])
}

model AcceptanceCriterion {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  text          String
  position      Int
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model Risk {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @unique @db.Uuid
  impact        Int
  likelihood    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model RequirementRevision {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  version       Int
  title         String
  description   String?
  createdBy     String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, version])
  @@index([requirementId])
}

model ReviewTask {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  requirementId String   @db.Uuid
  testCaseId    String?  @db.Uuid
  reason        String
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

enum TestCaseStatus {
  DRAFT
  READY
  RETIRED
}

model TestSuite {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   TestSuite?  @relation("SuiteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSuite[] @relation("SuiteTree")
  cases    TestCase[]

  @@index([projectId])
  @@index([parentId])
}

model TestCase {
  id                String         @id @default(uuid()) @db.Uuid
  projectId         String         @db.Uuid
  suiteId           String?        @db.Uuid
  code              String
  title             String
  priority          String         @default("MEDIUM")
  type              String         @default("FUNCTIONAL")
  status            TestCaseStatus @default(DRAFT)
  expectedResult    String?
  independentReason String?
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite     TestSuite?            @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  steps     TestStep[]
  revisions TestCaseRevision[]
  links     RequirementTestCase[]

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([suiteId])
}

model TestStep {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @db.Uuid
  position   Int
  action     String
  expected   String?
  createdAt  DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
}

model TestCaseRevision {
  id             String   @id @default(uuid()) @db.Uuid
  testCaseId     String   @db.Uuid
  version        Int
  title          String
  priority       String
  type           String
  expectedResult String?
  steps          Json
  createdBy      String
  createdAt      DateTime @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, version])
  @@index([testCaseId])
}

model RequirementTestCase {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  testCaseId    String   @db.Uuid
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
}

enum ReleaseStatus {
  DRAFT
  IN_TEST
  PASSED
  FAILED
  RELEASED
  ARCHIVED
}

model Release {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  name      String
  status    ReleaseStatus @default(DRAFT)
  frozen    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builds  Build[]
  runs    TestRun[]

  @@index([projectId])
}

model Build {
  id        String   @id @default(uuid()) @db.Uuid
  releaseId String   @db.Uuid
  number    String
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  runs    TestRun[]

  @@unique([releaseId, number])
  @@index([releaseId])
}
model Environment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    TestRun[]

  @@unique([projectId, name])
  @@index([projectId])
}

enum RunStatus {
  OPEN
  FINALIZED
}

model TestRun {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  releaseId     String    @db.Uuid
  buildId       String    @db.Uuid
  environmentId String    @db.Uuid
  name          String
  status        RunStatus @default(OPEN)
  version       Int       @default(1)
  createdBy     String
  createdAt     DateTime  @default(now())
  finalizedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  build   Build   @relation(fields: [buildId], references: [id], onDelete: Restrict)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  items   TestRunItem[]
  defectRetests Defect[]

  @@index([projectId])
  @@index([buildId])
}

model TestRunItem {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @db.Uuid
  testCaseId String   @db.Uuid
  snapshot   Json
  assigneeId String?
  position   Int
  createdAt  DateTime @default(now())

  run     TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([runId])
  @@index([testCaseId])
}

model TestResult {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @db.Uuid
  status       String
  actualResult String?
  reason       String?
  stepResults  Json?
  createdBy    String
  createdAt    DateTime @default(now())

  item TestRunItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  defectsFromResult Defect[]

  @@index([itemId])
}

enum DefectStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  FIXED
  RETEST
  CLOSED
  REOPENED
  REJECTED
}

model Defect {
  id                String       @id @default(uuid()) @db.Uuid
  projectId         String       @db.Uuid
  code              String
  title             String
  description       String?
  stepsToReproduce  String?
  severity          String       @default("MAJOR")
  priority          String       @default("MEDIUM")
  status            DefectStatus @default(NEW)
  reporterId        String
  assigneeId        String?
  fixedBuildId      String?      @db.Uuid
  sourceResultId    String?      @db.Uuid
  retestRunId       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history DefectHistory[]
  sourceResult TestResult? @relation(fields: [sourceResultId], references: [id], onDelete: SetNull)
  retestRun    TestRun?    @relation(fields: [retestRunId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([assigneeId])
}

model DefectHistory {
  id        String   @id @default(uuid()) @db.Uuid
  defectId  String   @db.Uuid
  from      String
  to        String
  actorId   String
  createdAt DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId])
}

model Evidence {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  filename     String
  originalName String
  mime         String
  size         Int
  checksum     String
  storagePath  String
  createdBy    String
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   EvidenceLink[]

  @@index([projectId])
}

model EvidenceLink {
  id         String   @id @default(uuid()) @db.Uuid
  evidenceId String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  createdAt  DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, entityType, entityId])
  @@index([entityType, entityId])
}

enum AnalysisStatus {
  SUCCEEDED
  PARTIAL
  FAILED
}

model Analysis {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @db.Uuid
  name           String?
  language       String
  sourceHash     String
  source         String
  adapterId      String
  adapterVersion String
  configHash     String
  status         AnalysisStatus @default(SUCCEEDED)
  diagnostics    Json?
  graph          Json?
  metrics        Json?
  durationMs     Int            @default(0)
  createdBy      String
  createdAt      DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceHash, adapterVersion, configHash])
  @@index([projectId])
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

model DesignModel {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  kind      String
  name      String?
  createdBy String
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inputs  DesignInput[]
  drafts  TestDraft[]

  @@index([projectId])
}

model DesignInput {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @db.Uuid
  payload   Json
  createdAt DateTime @default(now())

  model DesignModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model TestDraft {
  id             String      @id @default(uuid()) @db.Uuid
  projectId      String      @db.Uuid
  modelId        String?     @db.Uuid
  technique      String
  sourceRef      Json
  sources        Json
  inputs         Json
  expectedResult String?
  oracleStatus   String      @default("DEFINED")
  confidence     Int         @default(50)
  assumptions    Json?
  status         DraftStatus @default(PENDING)
  fingerprint    String
  testCaseId     String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  model   DesignModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  reviews DraftReview[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
}

model DraftReview {
  id       String   @id @default(uuid()) @db.Uuid
  draftId  String   @db.Uuid
  decision String
  diff     Json?
  reason   String?
  actorId  String
  createdAt DateTime @default(now())

  draft TestDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model CodeArtifact {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  language  String
  name      String
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions CodeVersion[]

  @@unique([projectId, language, name])
  @@index([projectId])
}

model CodeVersion {
  id         String   @id @default(uuid()) @db.Uuid
  artifactId String   @db.Uuid
  sourceHash String
  source     String
  analysisId String?  @db.Uuid
  createdAt  DateTime @default(now())

  artifact CodeArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  units    CodeUnit[]

  @@unique([artifactId, sourceHash])
  @@index([artifactId])
}

model CodeUnit {
  id            String   @id @default(uuid()) @db.Uuid
  artifactId    String   @db.Uuid
  versionId     String   @db.Uuid
  qualifiedName String
  signatureHash String
  sourceRange   Json?
  createdAt     DateTime @default(now())

  version CodeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, qualifiedName])
  @@index([artifactId, qualifiedName])
}

model RequirementCodeUnit {
  id            String   @id @default(uuid()) @db.Uuid
  requirementId String   @db.Uuid
  artifactId    String   @db.Uuid
  qualifiedName String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, artifactId, qualifiedName])
  @@index([artifactId, qualifiedName])
}

model ImpactAnalysis {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  fromVersionId String   @db.Uuid
  toVersionId   String   @db.Uuid
  result        Json
  createdBy     String
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum GateVersionStatus {
  DRAFT
  PUBLISHED
}

model QualityGate {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  createdBy String
  createdAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions GateVersion[]

  @@index([projectId])
}

model GateVersion {
  id        String            @id @default(uuid()) @db.Uuid
  gateId    String            @db.Uuid
  version   Int
  rules     Json
  status    GateVersionStatus @default(DRAFT)
  createdAt DateTime          @default(now())

  gate QualityGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([gateId, version])
  @@index([gateId])
}

model GateEvaluation {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  gateId        String   @db.Uuid
  gateVersionId String   @db.Uuid
  version       Int
  buildId       String   @db.Uuid
  verdict       String
  input         Json
  rules         Json
  results       Json
  createdBy     String
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([gateId, version])
  @@index([buildId])
}
